<Project>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WeightlessSource>$(MSBuildThisFileDirectory)../../../src/Weightless</WeightlessSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(WeightlessSource)/Graph.cs;$(WeightlessSource)/GraphCodec.cs;$(WeightlessSource)/Interpreter.cs;$(WeightlessSource)/Fixtures.cs" LinkBase="Weightless" />
    <Compile Include="$(MSBuildThisFileDirectory)LabRun.cs" Link="LabRun.cs" />
  </ItemGroup>
</Project>
